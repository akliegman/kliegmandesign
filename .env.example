# Copy to .env for local runs. On Heroku, set these with `heroku config:set`.

PORT=3001
ENV=local
CORS_ORIGINS=http://localhost:3001

POSTGRES_HOST=localhost
POSTGRES_DB=kliegmandesign
POSTGRES_USER=
POSTGRES_PASSWORD=

# Visit analytics (server/visits). Nothing is collected unless this is true.
VISITS_ENABLED=false
# Slack app bot token with the chat:write scope, and the channel it's invited to.
VISITS_SLACK_BOT_TOKEN=
VISITS_SLACK_CHANNEL_ID=
# Hostnames the collector accepts events from.
VISITS_ALLOWED_HOSTS=adamkliegman.com,www.adamkliegman.com
# Comma-separated CIDRs to ignore, such as your own home network.
VISITS_IGNORE_NETWORKS=
# Send /24 (IPv4) or /48 (IPv6) networks to Slack instead of full addresses.
VISITS_MASK_IP=false
VISITS_TIME_ZONE=America/New_York
# The privacy policy states these retention periods; change both together.
VISITS_IP_RETENTION_DAYS=7
VISITS_RETENTION_DAYS=30
VISITS_START_DELAY_SECONDS=20
VISITS_INACTIVITY_MINUTES=30
VISITS_START_COOLDOWN_MINUTES=360
VISITS_MAX_NOTIFICATIONS_PER_HOUR=20

# Tests only: `npm run test:visits` uses a local database, and posts to Slack when both are set.
VISITS_TEST_DATABASE_URL=postgres://localhost/kliegmandesign_visits_test
VISITS_TEST_SLACK_BOT_TOKEN=
VISITS_TEST_SLACK_CHANNEL_ID=
